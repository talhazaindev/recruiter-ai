# App
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_ORG_ID=default

# Auth seed admin
ADMIN_EMAIL=admin@recruiter.ai
ADMIN_PASSWORD=admin123456

# MongoDB
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=recruiter_ai

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1
S3_USE_SSL=false

# Parser / matcher
PARSER_MODE=local
MATCHER_MODE=stub
PARSE_CONFIDENCE_REVIEW_THRESHOLD=0.55
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Google Drive (optional for v1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/integrations/drive/callback

# API / Web
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# For local non-Docker API use localhost hosts:
# MONGODB_URI=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
