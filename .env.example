# App
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_ORG_ID=default

# Auth seed admin
ADMIN_EMAIL=admin@recruiter.ai
ADMIN_PASSWORD=admin123456

# MongoDB Atlas only (local MongoDB is not allowed)
# Cluster: recruit → DB: RecruiterAI → collection: jobs (and others)
MONGODB_URI=mongodb+srv://USER:PASSWORD@recruit.xxxxx.mongodb.net/?appName=recruit
MONGODB_DB=RecruiterAI
# Network Access: allow your IP (and Docker host egress). Avoid 0.0.0.0/0 except temporary tests.

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1
S3_USE_SSL=false

# Parser / matcher
# Parser auto-routes: single-column → custom PyMuPDF; multi-column → Docling.
# Matcher is ats-agent (must-have verify + relevant experience).
PARSE_CONFIDENCE_REVIEW_THRESHOLD=0.55
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Google Drive (optional for v1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/integrations/drive/callback

# API / Web
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# For local non-Docker API (Redis/MinIO only — Mongo stays Atlas):
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
